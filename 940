class Solution {
    public int distinctSubseqII(String s) {
        final int MOD = 1000000007;
        int[] last = new int[26];
        int dp = 1;

        for (int i = 0, n = s.length(); i < n; i++) {
            int c = s.charAt(i) - 'a';
            int next = dp + dp;

            if (next >= MOD) next -= MOD;

            next -= last[c];
            if (next < 0) next += MOD;

            last[c] = dp;
            dp = next;
        }

        return dp == 0 ? MOD - 1 : dp - 1;
    }
}
