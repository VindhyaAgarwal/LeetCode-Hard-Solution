class Solution {
    public int maxPalindromes(String s, int k) {
        int n = s.length();
        char[] c = s.toCharArray();
        int[] dp = new int[n + 1];
        int[] shortestStart = new int[n];
        java.util.Arrays.fill(shortestStart, -1);

        for (int center = 0; center < n; center++) {
            int l = center, r = center;
            while (l >= 0 && r < n && c[l] == c[r]) {
                if (r - l + 1 >= k) { shortestStart[r] = l; break; }
                l--; r++;
            }
            l = center; r = center + 1;
            while (l >= 0 && r < n && c[l] == c[r]) {
                if (r - l + 1 >= k) { shortestStart[r] = l; break; }
                l--; r++;
            }
        }

        for (int end = 1; end <= n; end++) {
            int best = dp[end - 1];
            int st = shortestStart[end - 1];
            if (st >= 0) {
                int v = dp[st] + 1;
                if (v > best) best = v;
            }
            dp[end] = best;
        }

        return dp[n];
    }
}
