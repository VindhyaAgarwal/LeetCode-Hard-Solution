class Solution {
    public int sortableIntegers(int[] nums) {
        int n = nums.length;
        int[] sorted = nums.clone();
        Arrays.sort(sorted);
        int[] mismatch = new int[n + 1];
        for (int i = 0; i < n; i++) mismatch[i + 1] = mismatch[i] + (nums[i] != sorted[i] ? 1 : 0);
        long ans = 0;
        for (int d = 1; (long) d * d <= n; d++) {
            if (n % d != 0) continue;
            if (isSortable(nums, sorted, d, n, mismatch)) ans += d;
            int other = n / d;
            if (other != d && isSortable(nums, sorted, other, n, mismatch)) ans += other;
        }
        return (int) ans;
    }

    private boolean isSortable(int[] nums, int[] sorted, int k, int n, int[] mismatch) {
        for (int b = 0; b < n; b += k) {
            if (mismatch[b + k] - mismatch[b] == 0) continue;
            if (!isRotation(nums, sorted, b, k)) return false;
        }
        return true;
    }

    private boolean isRotation(int[] nums, int[] sorted, int b, int k) {
        int start = 0, desc = 0, prev = nums[b + k - 1];
        for (int t = 0; t < k; t++) {
            int cur = nums[b + t];
            if (prev > cur) { if (++desc > 1) return false; start = t; }
            prev = cur;
        }
        if (desc == 0) {
            for (int t = 0; t < k; t++) if (nums[b + t] != sorted[b + t]) return false;
            return true;
        }
        for (int t = 0; t < k; t++) {
            int idx = start + t; if (idx >= k) idx -= k;
            if (nums[b + idx] != sorted[b + t]) return false;
        }
        return true;
    }
}
