class Solution {
    public int minimumChanges(String s, int k) {
        int n = s.length();
        char[] c = s.toCharArray();
        final int INF = 1000000;

        int[][] divs = new int[n + 1][];
        for (int len = 2; len <= n; len++) {
            int cnt = 0;
            for (int d = 1; d < len; d++) if (len % d == 0) cnt++;
            int[] arr = new int[cnt];
            int idx = 0;
            for (int d = 1; d < len; d++) if (len % d == 0) arr[idx++] = d;
            divs[len] = arr;
        }

        int[][] cost = new int[n][n];
        for (int i = 0; i < n; i++) {
            for (int j = i + 1; j < n; j++) {
                int len = j - i + 1;
                int[] ds = divs[len];
                int best = INF;
                for (int di = 0; di < ds.length; di++) {
                    int d = ds[di];
                    int changes = 0, m = len / d;
                    for (int g = 0; g < d; g++) {
                        int a = 0, b = m - 1;
                        int base = i + g;
                        while (a < b) {
                            if (c[base + a * d] != c[base + b * d]) changes++;
                            a++; b--;
                        }
                    }
                    if (changes < best) best = changes;
                }
                cost[i][j] = best;
            }
        }

        int[][] dp = new int[k + 1][n + 1];
        for (int[] row : dp) java.util.Arrays.fill(row, INF);
        dp[0][0] = 0;
        for (int i = 2; i <= n; i++) {
            int maxJ = Math.min(k, i / 2);
            for (int j = 1; j <= maxJ; j++) {
                int best = INF;
                int lo = (j - 1) * 2;
                int[] prev = dp[j - 1];
                for (int p = lo; p <= i - 2; p++) {
                    int v = prev[p] + cost[p][i - 1];
                    if (v < best) best = v;
                }
                dp[j][i] = best;
            }
        }
        return dp[k][n];
    }
}
