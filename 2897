class Solution {
    public int maxSum(List<Integer> nums, int k) {
        int MOD = 1_000_000_007;
        int[] bitCount = new int[32];
        
        for (int num : nums) {
            int x = num;
            while (x != 0) {
                int b = Integer.numberOfTrailingZeros(x);
                bitCount[b]++;
                x &= x - 1;
            }
        }
        
        long[] top = new long[k];
        for (int b = 0; b < 32; b++) {
            int cnt = Math.min(bitCount[b], k);
            long bitVal = 1L << b;
            for (int i = 0; i < cnt; i++) {
                top[i] |= bitVal;
            }
        }
        
        long sum = 0;
        for (long val : top) {
            sum = (sum + (val % MOD) * (val % MOD)) % MOD;
        }
        
        return (int) sum;
    }
}
