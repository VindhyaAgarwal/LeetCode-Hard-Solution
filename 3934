import java.util.*;

class Solution {
    public int smallestUniqueSubarray(int[] nums) {
        int n = nums.length;
        int[] sa = buildSA(nums);
        int[] rank = new int[n];
        for (int i = 0; i < n; i++) rank[sa[i]] = i;

        int[] lcp = new int[n];
        int k = 0;
        for (int i = 0; i < n; i++) {
            if (rank[i] == 0) { k = 0; continue; }
            int j = sa[rank[i] - 1];
            while (i + k < n && j + k < n && nums[i + k] == nums[j + k]) k++;
            lcp[rank[i]] = k;
            if (k > 0) k--;
        }

        int ans = n;
        for (int p = 0; p < n; p++) {
            int prev = (p > 0) ? lcp[p] : 0;
            int next = (p + 1 < n) ? lcp[p + 1] : 0;
            int need = Math.max(prev, next) + 1;
            if (need <= n - sa[p] && need < ans) ans = need;
        }
        return ans;
    }

    private int[] buildSA(int[] s) {
        int n = s.length;
        int[] sorted = s.clone();
        Arrays.sort(sorted);
        HashMap<Integer,Integer> map = new HashMap<>();
        int cid = 0;
        for (int v : sorted) if (!map.containsKey(v)) map.put(v, cid++);
        int[] r = new int[n];
        for (int i = 0; i < n; i++) r[i] = map.get(s[i]);

        int[] sa = new int[n];
        for (int i = 0; i < n; i++) sa[i] = i;
        int[] tmpR = new int[n];
        int[] sa2 = new int[n];
        int[] cnt = new int[n + 2];

        for (int len = 1; ; len <<= 1) {
            int maxR = 0;
            for (int i = 0; i < n; i++) maxR = Math.max(maxR, r[i]);

            Arrays.fill(cnt, 0, maxR + 2, 0);
            for (int i = 0; i < n; i++) {
                int key = (sa[i] + len < n) ? r[sa[i] + len] + 1 : 0;
                cnt[key]++;
            }
            for (int i = 1; i <= maxR + 1; i++) cnt[i] += cnt[i-1];
            for (int i = n - 1; i >= 0; i--) {
                int key = (sa[i] + len < n) ? r[sa[i] + len] + 1 : 0;
                sa2[--cnt[key]] = sa[i];
            }

            Arrays.fill(cnt, 0, maxR + 1, 0);
            for (int i = 0; i < n; i++) cnt[r[sa2[i]]]++;
            for (int i = 1; i <= maxR; i++) cnt[i] += cnt[i-1];
            for (int i = n - 1; i >= 0; i--) {
                int v = sa2[i];
                sa[--cnt[r[v]]] = v;
            }

            tmpR[sa[0]] = 0;
            int classes = 0;
            for (int i = 1; i < n; i++) {
                int a = sa[i-1], b = sa[i];
                int ra = (a + len < n) ? r[a + len] : -1;
                int rb = (b + len < n) ? r[b + len] : -1;
                if (r[a] != r[b] || ra != rb) classes++;
                tmpR[b] = classes;
            }
            System.arraycopy(tmpR, 0, r, 0, n);
            if (classes == n - 1) break;
        }
        return sa;
    }
}
