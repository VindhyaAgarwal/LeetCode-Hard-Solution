class Solution {
    public long countNonDecreasingSubarrays(int[] nums, int k) {

        int n = nums.length;

        int[] dq = new int[n];
        int head = 0, tail = 0;

        int j = n - 1;

        long cost = 0;
        long ans = 0;

        for (int i = n - 1; i >= 0; i--) {

            int num = nums[i];

            while (tail > head && nums[dq[tail - 1]] < num) {

                int p = dq[--tail];

                int r = tail == head ? j + 1 : dq[tail - 1];

                cost += (long) (r - p) * (num - nums[p]);
            }

            dq[tail++] = i;

            while (cost > k) {

                cost -= (long) nums[dq[head]] - nums[j];

                if (dq[head] == j)
                    head++;

                j--;
            }

            ans += j - i + 1;
        }

        return ans;
    }
}
